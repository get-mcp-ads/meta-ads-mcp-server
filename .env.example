# ─────────────────────────────────────────────────────────────────────────────
# meta-ads-mcp-server configuration
# Only META_ACCESS_TOKEN is required. Everything else has a default.
# ─────────────────────────────────────────────────────────────────────────────

# A Meta access token with, at minimum, the ads_read permission.
# The recommended way to get one is a System User token from Meta Business
# Settings. It does not expire and needs no App Review for your own accounts.
# See the "Getting a token" section of the README.
META_ACCESS_TOKEN=

# Graph API version. Defaults to v26.0. Override only if you need to pin
# an older version or test a newer one.
# META_API_VERSION=v26.0

# Write tools are OFF by default. Set to 1 to register the 10 write tools.
# They require the ads_management permission, not just ads_read.
# Every write still previews first and applies only on a second call
# with confirm: true.
# META_ENABLE_WRITES=1

# debug | info | warn | error
# LOG_LEVEL=info
